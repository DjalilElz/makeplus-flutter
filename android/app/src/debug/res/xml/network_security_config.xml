<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. Gradle overlays this over the main config for the debug
  variant, so none of it reaches a release build or the Play Store.

  Allows plain HTTP to a local Django instance and trusts user-installed CAs so
  a proxy (Charles / mitmproxy) can inspect traffic during development.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator's alias for the host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
